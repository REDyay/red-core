#!/usr/bin/env bash
set -euo pipefail

daemon="${REDCORE_DAEMON:-}"

if [ -z "$daemon" ] && [ -x "$HOME/.local/lib/red-core/redcore-daemon" ]; then
    daemon="$HOME/.local/lib/red-core/redcore-daemon"
fi

if [ -z "$daemon" ]; then
    daemon="$(command -v redcore-daemon || true)"
fi

if [ -z "$daemon" ] && [ -x "$HOME/red-core/rust/redcore-daemon/target/release/redcore-daemon" ]; then
    daemon="$HOME/red-core/rust/redcore-daemon/target/release/redcore-daemon"
fi

if [ -z "$daemon" ]; then
    daemon="$HOME/red-core/rust/redcore-daemon/target/debug/redcore-daemon"
fi

if [ ! -x "$daemon" ]; then
    printf 'Red Core daemon not found: %s\n' "$daemon" >&2
    exit 127
fi

if [ "${1:-}" = "--once" ]; then
    exec "$daemon" --system-monitor-once
fi

exec "$daemon" --system-monitor
