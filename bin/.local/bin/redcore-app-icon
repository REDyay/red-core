#!/usr/bin/env python3

import configparser
import os
import sys
from pathlib import Path

app_id = (
    sys.argv[1].strip()
    if len(sys.argv) > 1
    else ""
)

icon_name = (
    sys.argv[2].strip()
    if len(sys.argv) > 2
    else ""
)

home = Path.home()

# ------------------------------------------------------------
# Standard XDG application directories
# ------------------------------------------------------------

xdg_data_home = Path(
    os.environ.get(
        "XDG_DATA_HOME",
        home / ".local/share"
    )
)

xdg_data_dirs = [
    Path(p)
    for p in os.environ.get(
        "XDG_DATA_DIRS",
        "/usr/local/share:/usr/share"
    ).split(":")
    if p
]

data_dirs = [
    xdg_data_home,
    *xdg_data_dirs
]

application_dirs = [
    directory / "applications"
    for directory in data_dirs
]

icon_dirs = [
    xdg_data_home / "icons",
    xdg_data_home / "pixmaps",
]

for directory in xdg_data_dirs:
    icon_dirs.append(directory / "icons")
    icon_dirs.append(directory / "pixmaps")

# Keep order but remove duplicates.
seen_dirs = set()
icon_dirs = [
    directory
    for directory in icon_dirs
    if not (
        str(directory) in seen_dirs
        or seen_dirs.add(str(directory))
    )
]

extensions = (
    ".svg",
    ".png",
    ".xpm",
    ".jpg",
    ".jpeg",
    ".webp",
)

# ------------------------------------------------------------
# If QML couldn't get an icon name, try desktop entries here too.
# ------------------------------------------------------------

def normalize(value):
    return (
        value.lower()
        .replace("_", "-")
        .replace(" ", "-")
    )


def find_desktop_icon():
    if not app_id:
        return ""

    target = normalize(app_id)

    best = None

    for directory in application_dirs:
        if not directory.exists():
            continue

        try:
            files = directory.glob("*.desktop")
        except OSError:
            continue

        for file in files:
            stem = normalize(file.stem)

            score = 0

            if stem == target:
                score = 100
            elif stem.endswith("." + target):
                score = 90
            elif target in stem:
                score = 60

            try:
                parser = configparser.ConfigParser(
                    interpolation=None,
                    strict=False
                )

                parser.read(
                    file,
                    encoding="utf-8"
                )

                if "Desktop Entry" not in parser:
                    continue

                entry = parser["Desktop Entry"]

                startup = normalize(
                    entry.get(
                        "StartupWMClass",
                        ""
                    )
                )

                name = normalize(
                    entry.get(
                        "Name",
                        ""
                    )
                )

                if startup == target:
                    score = max(score, 95)

                if name == target:
                    score = max(score, 80)

                candidate_icon = (
                    entry.get("Icon", "").strip()
                )

                if (
                    candidate_icon
                    and (
                        best is None
                        or score > best[0]
                    )
                ):
                    best = (
                        score,
                        candidate_icon
                    )

            except Exception:
                continue

    if best is None:
        return ""

    return best[1]


if not icon_name:
    icon_name = find_desktop_icon()

# ------------------------------------------------------------
# Absolute path in Icon= is already usable.
# ------------------------------------------------------------

if icon_name:
    direct = Path(
        os.path.expanduser(icon_name)
    )

    if (
        direct.is_absolute()
        and direct.is_file()
    ):
        print(direct.as_uri())
        raise SystemExit(0)

# ------------------------------------------------------------
# Search actual XDG icon files.
# ------------------------------------------------------------

names = []

for value in (icon_name, app_id):
    value = value.strip()

    if not value:
        continue

    base = Path(value).name

    # Desktop Icon values normally omit extension.
    for extension in ("", *extensions):
        candidate = (
            base
            if extension == ""
            else base + extension
        )

        if candidate not in names:
            names.append(candidate)

# First check pixmaps/direct children cheaply.
for directory in icon_dirs:
    if not directory.exists():
        continue

    for name in names:
        candidate = directory / name

        if (
            candidate.is_file()
            and candidate.suffix.lower()
            in extensions
        ):
            print(candidate.as_uri())
            raise SystemExit(0)

# Then recursively search icon themes.
# Prefer exact filenames.
for directory in icon_dirs:
    if not directory.exists():
        continue

    try:
        for name in names:
            for candidate in directory.rglob(name):
                if (
                    candidate.is_file()
                    and candidate.suffix.lower()
                    in extensions
                ):
                    print(candidate.as_uri())
                    raise SystemExit(0)
    except (OSError, PermissionError):
        pass

# No icon found.
print("")
