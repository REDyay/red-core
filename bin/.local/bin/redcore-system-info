#!/usr/bin/env bash

# ---------------------------
# CPU usage
# ---------------------------
read -r cpu user nice system idle iowait irq softirq steal _ < /proc/stat
total1=$((user + nice + system + idle + iowait + irq + softirq + steal))
idle1=$((idle + iowait))

sleep 0.25

read -r cpu user nice system idle iowait irq softirq steal _ < /proc/stat
total2=$((user + nice + system + idle + iowait + irq + softirq + steal))
idle2=$((idle + iowait))

total_delta=$((total2 - total1))
idle_delta=$((idle2 - idle1))

if (( total_delta > 0 )); then
    cpu_usage=$((100 * (total_delta - idle_delta) / total_delta))
else
    cpu_usage=0
fi

# ---------------------------
# CPU temperature
# ---------------------------
cpu_temp="null"

for hwmon in /sys/class/hwmon/hwmon*; do
    [ -r "$hwmon/name" ] || continue
    name=$(cat "$hwmon/name")

    case "$name" in
        coretemp|k10temp|zenpower)
            hottest=0

            for input in "$hwmon"/temp*_input; do
                [ -r "$input" ] || continue
                value=$(cat "$input")

                if (( value > hottest )); then
                    hottest=$value
                fi
            done

            if (( hottest > 0 )); then
                cpu_temp=$((hottest / 1000))
                break
            fi
            ;;
    esac
done

# ---------------------------
# RAM
# ---------------------------
read -r mem_total mem_available < <(
    awk '
        /MemTotal:/ {total=$2}
        /MemAvailable:/ {available=$2}
        END {print total, available}
    ' /proc/meminfo
)

if (( mem_total > 0 )); then
    ram_usage=$((100 * (mem_total - mem_available) / mem_total))
else
    ram_usage=0
fi

# ---------------------------
# GPU detection
# ---------------------------
gpu_name=$(lspci 2>/dev/null | awk -F': ' '
    /VGA compatible controller|3D controller|Display controller/ {
        print $2
        exit
    }
')

[ -n "$gpu_name" ] || gpu_name="Unknown"

gpu_vendor="unknown"
gpu_usage="null"

case "$gpu_name" in
    *Intel*)
        gpu_vendor="intel"

        if command -v intel_gpu_top >/dev/null 2>&1; then
            gpu_usage=$(
                timeout -s INT 2 intel_gpu_top -J 2>/dev/null |
                python3 -c '
import json, sys

try:
    data = json.load(sys.stdin)

    if isinstance(data, list) and len(data) > 1:
        sample = data[-1]
        value = sample["engines"]["Render/3D"]["busy"]
        print(round(value))
    else:
        print("null")
except Exception:
    print("null")
'
            )
        fi
        ;;

    *AMD*|*ATI*)
        gpu_vendor="amd"

        for busy in /sys/class/drm/card*/device/gpu_busy_percent; do
            if [ -r "$busy" ]; then
                gpu_usage=$(cat "$busy")
                break
            fi
        done
        ;;

    *NVIDIA*)
        gpu_vendor="nvidia"

        if command -v nvidia-smi >/dev/null 2>&1; then
            gpu_usage=$(
                nvidia-smi \
                    --query-gpu=utilization.gpu \
                    --format=csv,noheader,nounits \
                    2>/dev/null |
                head -n1
            )

            [ -n "$gpu_usage" ] || gpu_usage="null"
        fi
        ;;
esac

# ---------------------------
# Active network interface
# ---------------------------
interface=$(ip route get 1.1.1.1 2>/dev/null |
    awk '{
        for (i=1; i<=NF; i++)
            if ($i=="dev") {
                print $(i+1)
                exit
            }
    }'
)

network_type="none"
download=0
upload=0

if [ -n "$interface" ] && [ -d "/sys/class/net/$interface" ]; then

    if [ -d "/sys/class/net/$interface/wireless" ]; then
        network_type="wifi"
    else
        network_type="ethernet"
    fi

    rx=$(cat "/sys/class/net/$interface/statistics/rx_bytes")
    tx=$(cat "/sys/class/net/$interface/statistics/tx_bytes")

    state_dir="$HOME/.local/state/red-core"
    state_file="$state_dir/network-stats"

    mkdir -p "$state_dir"

    if [ -f "$state_file" ]; then
        read -r old_interface old_rx old_tx old_time < "$state_file"

        now=$(date +%s)

        if [ "$old_interface" = "$interface" ]; then
            elapsed=$((now - old_time))

            if (( elapsed > 0 )); then
                download=$(((rx - old_rx) / elapsed))
                upload=$(((tx - old_tx) / elapsed))

                (( download < 0 )) && download=0
                (( upload < 0 )) && upload=0
            fi
        fi
    fi

    printf '%s %s %s %s\n' \
        "$interface" "$rx" "$tx" "$(date +%s)" > "$state_file"
fi

# ---------------------------
# JSON escaping
# ---------------------------
gpu_name=${gpu_name//\\/\\\\}
gpu_name=${gpu_name//\"/\\\"}

printf '{
  "cpu": %d,
  "cpuTemp": %s,
  "ram": %d,
  "gpuName": "%s",
  "gpuVendor": "%s",
  "gpuUsage": %s,
  "network": {
    "interface": "%s",
    "type": "%s",
    "download": %d,
    "upload": %d
  }
}\n' \
"$cpu_usage" \
"$cpu_temp" \
"$ram_usage" \
"$gpu_name" \
"$gpu_vendor" \
"$gpu_usage" \
"$interface" \
"$network_type" \
"$download" \
"$upload"
