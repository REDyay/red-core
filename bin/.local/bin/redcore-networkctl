#!/usr/bin/env python3

import json
import os
import pty
import select
import shutil
import signal
import subprocess
import sys
import termios
import time


ENV = os.environ.copy()
ENV["LC_ALL"] = "C"


def run(args, timeout=15):
    try:
        proc = subprocess.run(
            args,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
            check=False,
            env=ENV,
        )

        return (
            proc.returncode,
            proc.stdout.strip(),
            proc.stderr.strip(),
        )

    except subprocess.TimeoutExpired:
        return 124, "", "Operation timed out"

    except Exception as error:
        return 1, "", str(error)


def output_json(data, exit_code=0):
    print(
        json.dumps(
            data,
            ensure_ascii=False,
            separators=(",", ":"),
        )
    )

    raise SystemExit(exit_code)


def nmcli_exists():
    return shutil.which("nmcli") is not None


def split_terse(line):
    result = []
    current = []
    escaped = False

    for char in line:
        if escaped:
            current.append(char)
            escaped = False
            continue

        if char == "\\":
            escaped = True
            continue

        if char == ":":
            result.append(
                "".join(current)
            )
            current = []
            continue

        current.append(char)

    result.append(
        "".join(current)
    )

    return result


def is_protected(security):
    security = (
        security or ""
    ).strip().upper()

    return security not in {
        "",
        "--",
        "OPEN",
    }


def wifi_devices():
    if not nmcli_exists():
        return []

    code, text, _ = run([
        "nmcli",
        "-t",
        "--escape",
        "yes",
        "-f",
        "DEVICE,TYPE,STATE,CONNECTION",
        "device",
        "status",
    ])

    if code != 0:
        return []

    devices = []

    for line in text.splitlines():
        fields = split_terse(line)

        if len(fields) < 4:
            continue

        device, typ, state, connection = (
            fields[:4]
        )

        if typ != "wifi":
            continue

        devices.append({
            "device": device,
            "state": state,
            "connection": connection,
        })

    return devices


def active_uuid_for_device(device):
    code, text, _ = run([
        "nmcli",
        "-t",
        "--escape",
        "yes",
        "-f",
        "UUID,TYPE,DEVICE",
        "connection",
        "show",
        "--active",
    ])

    if code != 0:
        return ""

    for line in text.splitlines():
        fields = split_terse(line)

        if len(fields) < 3:
            continue

        uuid, typ, active_device = (
            fields[:3]
        )

        if (
            active_device == device
            and typ == "802-11-wireless"
        ):
            return uuid

    return ""


def connection_profiles():
    """
    Saved Wi-Fi profiles.

    Red Core intentionally does NOT read stored passwords.
    NetworkManager remains the owner of saved credentials.
    """

    profiles = []

    code, text, _ = run([
        "nmcli",
        "-t",
        "--escape",
        "yes",
        "-f",
        "UUID,TYPE,NAME",
        "connection",
        "show",
    ])

    if code != 0:
        return profiles

    for line in text.splitlines():
        fields = split_terse(line)

        if len(fields) < 3:
            continue

        uuid, typ, name = fields[:3]

        if typ != "802-11-wireless":
            continue

        _, ssid, _ = run([
            "nmcli",
            "-g",
            "802-11-wireless.ssid",
            "connection",
            "show",
            "uuid",
            uuid,
        ])

        ssid = ssid.strip()

        if not ssid:
            continue

        _, key_mgmt, _ = run([
            "nmcli",
            "-g",
            "802-11-wireless-security.key-mgmt",
            "connection",
            "show",
            "uuid",
            uuid,
        ])

        profiles.append({
            "uuid": uuid,
            "name": name,
            "ssid": ssid,
            "keyMgmt": key_mgmt.strip(),
        })

    return profiles

def profiles_for_ssid(ssid):
    return [
        profile
        for profile in connection_profiles()
        if profile["ssid"] == ssid
    ]


def first_wifi_device():
    devices = wifi_devices()

    if not devices:
        return ""

    # Prefer connected Wi-Fi.
    for item in devices:
        if item["state"] == "connected":
            return item["device"]

    return devices[0]["device"]


def wifi_enabled():
    if not nmcli_exists():
        return False

    code, text, _ = run([
        "nmcli",
        "radio",
        "wifi",
    ])

    return (
        code == 0
        and text.strip().lower()
            == "enabled"
    )


def default_route_device():
    """
    Return the interface carrying the preferred default route.

    IPv4 is checked first, then IPv6.
    Lowest route metric wins.
    """

    for family in ("-4", "-6"):
        code, output, _ = run([
            "ip",
            "-j",
            family,
            "route",
            "show",
            "default",
        ])

        if code != 0 or not output:
            continue

        try:
            routes = json.loads(output)
        except Exception:
            continue

        candidates = []

        for route in routes:
            device = str(
                route.get("dev", "")
            ).strip()

            if not device:
                continue

            try:
                metric = int(
                    route.get("metric", 0)
                )
            except Exception:
                metric = 0

            candidates.append(
                (metric, device)
            )

        if candidates:
            candidates.sort(
                key=lambda item: item[0]
            )

            return candidates[0][1]

    return ""


def state():
    result = {
        "nmAvailable": False,
        "wifiHardware": False,
        "wifiEnabled": False,
        "connected": False,
        "type": "none",
        "device": "",
        "connection": "",
        "uuid": "",
        "ssid": "",
        "signal": None,
        "security": "",
        "ip": "",
        "gateway": "",
        "connectivity": "unknown",
    }

    if not nmcli_exists():
        return result

    code, running, _ = run([
        "nmcli",
        "-t",
        "-f",
        "RUNNING",
        "general",
    ])

    if (
        code != 0
        or running.strip().lower() != "running"
    ):
        return result

    result["nmAvailable"] = True

    code, connectivity, _ = run([
        "nmcli",
        "-t",
        "-f",
        "CONNECTIVITY",
        "general",
    ])

    if code == 0 and connectivity:
        result["connectivity"] = (
            connectivity.strip()
        )

    result["wifiEnabled"] = (
        wifi_enabled()
    )

    wifi = wifi_devices()

    result["wifiHardware"] = (
        len(wifi) > 0
    )

    code, devices_text, _ = run([
        "nmcli",
        "-t",
        "--escape",
        "yes",
        "-f",
        "DEVICE,TYPE,STATE,CONNECTION",
        "device",
        "status",
    ])

    if code != 0:
        return result

    connected_devices = []

    for line in devices_text.splitlines():
        fields = split_terse(line)

        if len(fields) < 4:
            continue

        device, typ, device_state, conn = (
            fields[:4]
        )

        if (
            typ not in {"wifi", "ethernet"}
            or device_state != "connected"
        ):
            continue

        connected_devices.append({
            "device": device,
            "type": typ,
            "connection": conn,
        })

    if not connected_devices:
        result["device"] = (
            first_wifi_device()
        )

        if result["wifiHardware"]:
            result["type"] = "wifi"

        return result

    # Prefer the physical interface that actually
    # carries the kernel's default route.
    route_device = (
        default_route_device()
    )

    selected = None

    for item in connected_devices:
        if item["device"] == route_device:
            selected = item
            break

    # If no physical interface owns the default route
    # (for example a future VPN), keep a sane physical
    # fallback. Wired is preferred only as fallback.
    if selected is None:
        for item in connected_devices:
            if item["type"] == "ethernet":
                selected = item
                break

    if selected is None:
        selected = connected_devices[0]

    connected_device = (
        selected["device"]
    )

    connected_type = (
        selected["type"]
    )

    result["connected"] = True
    result["device"] = connected_device
    result["type"] = connected_type
    result["connection"] = (
        selected["connection"]
    )

    result["uuid"] = (
        active_uuid_for_device(
            connected_device
        )
    )

    if connected_type == "wifi":
        code, wifi_text, _ = run([
            "nmcli",
            "-t",
            "--escape",
            "yes",
            "-f",
            "ACTIVE,SSID,SIGNAL,SECURITY,DEVICE",
            "device",
            "wifi",
            "list",
            "--rescan",
            "no",
        ])

        if code == 0:
            for line in wifi_text.splitlines():
                fields = split_terse(line)

                if len(fields) < 5:
                    continue

                active, ssid, signal, security, device = (
                    fields[:5]
                )

                if (
                    active != "yes"
                    or device != connected_device
                ):
                    continue

                result["ssid"] = ssid
                result["security"] = security

                try:
                    result["signal"] = int(signal)
                except Exception:
                    result["signal"] = None

                break

    code, ip_text, _ = run([
        "nmcli",
        "-t",
        "-f",
        "IP4.ADDRESS,IP4.GATEWAY",
        "device",
        "show",
        connected_device,
    ])

    if code == 0:
        for line in ip_text.splitlines():
            if line.startswith("IP4.ADDRESS"):
                result["ip"] = (
                    line.partition(":")[2]
                )

            elif line.startswith("IP4.GATEWAY"):
                result["gateway"] = (
                    line.partition(":")[2]
                )

    return result

def list_networks(rescan=False):
    device = first_wifi_device()

    if (
        not device
        or not wifi_enabled()
    ):
        return []

    if rescan:
        run([
            "nmcli",
            "device",
            "wifi",
            "rescan",
            "ifname",
            device,
        ], timeout=8)

        # Give the scan result a short moment
        # to reach NetworkManager.
        time.sleep(0.7)

    code, text, _ = run([
        "nmcli",
        "-t",
        "--escape",
        "yes",
        "-f",
        "ACTIVE,SSID,SIGNAL,SECURITY,DEVICE",
        "device",
        "wifi",
        "list",
        "--rescan",
        "no",
    ])

    if code != 0:
        return []

    profiles = connection_profiles()

    saved_map = {}

    for profile in profiles:
        previous = saved_map.get(
            profile["ssid"]
        )

        if (
            previous is None
            or (
                profile["hasSecret"]
                and not previous[
                    "hasSecret"
                ]
            )
        ):
            saved_map[
                profile["ssid"]
            ] = profile

    networks = {}

    for line in text.splitlines():
        fields = split_terse(line)

        if len(fields) < 5:
            continue

        active, ssid, signal, security, net_device = (
            fields[:5]
        )

        if (
            not ssid
            or net_device != device
        ):
            continue

        try:
            strength = int(signal)
        except Exception:
            strength = -1

        saved = saved_map.get(ssid)

        entry = {
            "ssid": ssid,
            "signal": strength,
            "security":
                security or "Open",
            "device": net_device,
            "active": active == "yes",
            "saved": saved is not None,
            "savedUuid":
                saved["uuid"]
                if saved else "",
        }

        previous = networks.get(ssid)

        if (
            previous is None
            or entry["active"]
            or strength >
                previous["signal"]
        ):
            networks[ssid] = entry

    result = list(
        networks.values()
    )

    result.sort(
        key=lambda item: (
            not item["active"],
            -item["signal"],
            item["ssid"].lower(),
        )
    )

    return result


def restore_previous(
    previous_uuid,
    device
):
    if not previous_uuid:
        return

    run([
        "nmcli",
        "--wait",
        "12",
        "connection",
        "up",
        "uuid",
        previous_uuid,
        "ifname",
        device,
    ], timeout=15)


def run_nmcli_with_secret(
    command,
    password,
    timeout=24,
):
    """
    Run nmcli --ask in a real pseudo-terminal.

    Secret is written through the PTY and never placed in argv.
    """

    env = ENV.copy()

    pid, master_fd = pty.fork()

    if pid == 0:
        try:
            os.execvpe(
                command[0],
                command,
                env,
            )
        except Exception:
            os._exit(127)

    # Prevent password echo in our captured PTY output.
    try:
        attrs = termios.tcgetattr(
            master_fd
        )

        attrs[3] &= ~termios.ECHO

        termios.tcsetattr(
            master_fd,
            termios.TCSANOW,
            attrs,
        )

    except Exception:
        pass

    output = bytearray()
    deadline = (
        time.monotonic() +
        timeout
    )

    # PTYs buffer input, so sending immediately is safer
    # than depending on exact/localized prompt text.
    try:
        os.write(
            master_fd,
            (
                password +
                "\\n"
            ).encode()
        )
    except Exception:
        pass

    status = None

    try:
        while True:
            finished, child_status = (
                os.waitpid(
                    pid,
                    os.WNOHANG
                )
            )

            if finished == pid:
                status = child_status
                break

            if (
                time.monotonic() >=
                deadline
            ):
                try:
                    os.kill(
                        pid,
                        signal.SIGTERM
                    )
                except Exception:
                    pass

                try:
                    _, status = os.waitpid(
                        pid,
                        0
                    )
                except Exception:
                    status = None

                return (
                    124,
                    "Connection timed out"
                )

            ready, _, _ = select.select(
                [master_fd],
                [],
                [],
                0.2
            )

            if not ready:
                continue

            try:
                chunk = os.read(
                    master_fd,
                    4096
                )
            except OSError:
                continue

            if chunk:
                output.extend(chunk)

        # Drain final output.
        while True:
            ready, _, _ = select.select(
                [master_fd],
                [],
                [],
                0
            )

            if not ready:
                break

            try:
                chunk = os.read(
                    master_fd,
                    4096
                )
            except OSError:
                break

            if not chunk:
                break

            output.extend(chunk)

    finally:
        try:
            os.close(master_fd)
        except OSError:
            pass

    try:
        code = os.waitstatus_to_exitcode(
            status
        )
    except Exception:
        code = 1

    message = output.decode(
        "utf-8",
        errors="replace"
    )

    # Password must never reach QML/log output either.
    if password:
        message = message.replace(
            password,
            "********"
        )

    message = " ".join(
        part.strip()
        for part in message.splitlines()
        if part.strip()
    )

    return code, message


def hidden_profile_mode(profile):
    key_mgmt = str(
        profile.get(
            "keyMgmt",
            ""
        )
    ).strip()

    if key_mgmt == "sae":
        return "sae"

    if key_mgmt == "wpa-psk":
        return "wpa-psk"

    if key_mgmt in ("", "none"):
        return "open"

    return key_mgmt


def connect_hidden_network(
    ssid,
    device,
    password,
    security_mode,
    previous_uuid,
):
    if security_mode not in {
        "open",
        "wpa-psk",
        "sae",
    }:
        return {
            "success": False,
            "message":
                "Unsupported security type",
        }

    protected = (
        security_mode != "open"
    )

    # First try an existing compatible profile.
    for profile in profiles_for_ssid(
        ssid
    ):
        if (
            hidden_profile_mode(
                profile
            ) != security_mode
        ):
            continue

        code, out, error = run([
            "nmcli",
            "--wait",
            "15",
            "connection",
            "up",
            "uuid",
            profile["uuid"],
            "ifname",
            device,
        ], timeout=18)

        if code == 0:
            return {
                "success": True,
                "message":
                    "Connected to " +
                    ssid,
            }

    if protected and not password:
        return {
            "success": False,
            "passwordRequired": True,
            "message": "Password required",
        }

    before = {
        profile["uuid"]
        for profile
        in profiles_for_ssid(
            ssid
        )
    }

    # Create an explicit hidden Wi-Fi profile.
    command = [
        "nmcli",
        "connection",
        "add",
        "type",
        "wifi",
        "ifname",
        device,
        "con-name",
        ssid,
        "ssid",
        ssid,
        "connection.autoconnect",
        "yes",
        "802-11-wireless.hidden",
        "yes",
    ]

    if security_mode == "wpa-psk":
        command += [
            "802-11-wireless-security.key-mgmt",
            "wpa-psk",
        ]

    elif security_mode == "sae":
        command += [
            "802-11-wireless-security.key-mgmt",
            "sae",
        ]

    code, out, error = run(
        command
    )

    if code != 0:
        restore_previous(
            previous_uuid,
            device
        )

        return {
            "success": False,
            "message":
                error
                or out
                or "Could not create hidden network profile",
        }

    created = [
        profile
        for profile
        in profiles_for_ssid(ssid)
        if profile["uuid"] not in before
    ]

    if not created:
        restore_previous(
            previous_uuid,
            device
        )

        return {
            "success": False,
            "message":
                "Could not locate created profile",
        }

    profile = created[-1]
    uuid = profile["uuid"]

    activate = [
        "nmcli",
        "--wait",
        "18",
        "connection",
        "up",
        "uuid",
        uuid,
        "ifname",
        device,
    ]

    if protected:
        activate.insert(
            1,
            "--ask"
        )

        code, message = (
            run_nmcli_with_secret(
                activate,
                password,
            )
        )

        out = message
        error = ""

    else:
        code, out, error = run(
            activate,
            timeout=22
        )

    if code == 0:
        return {
            "success": True,
            "message":
                "Connected to " +
                ssid,
        }

    # Remove only the failed profile
    # Red Core just created.
    run([
        "nmcli",
        "connection",
        "delete",
        "uuid",
        uuid,
    ])

    restore_previous(
        previous_uuid,
        device
    )

    return {
        "success": False,
        "passwordRequired":
            protected,
        "message":
            error
            or out
            or "Connection failed",
    }


def connect_action(payload):
    ssid = str(
        payload.get("ssid", "")
    ).strip()

    security = str(
        payload.get(
            "security",
            ""
        )
    ).strip()

    device = str(
        payload.get(
            "device",
            ""
        )
    ).strip() or first_wifi_device()

    saved_uuid = str(
        payload.get(
            "savedUuid",
            ""
        )
    ).strip()

    password = str(
        payload.get(
            "password",
            ""
        )
    )

    hidden = bool(
        payload.get(
            "hidden",
            False
        )
    )

    security_mode = str(
        payload.get(
            "securityMode",
            ""
        )
    ).strip()

    if not ssid:
        return {
            "success": False,
            "message": "Missing SSID",
        }

    if not device:
        return {
            "success": False,
            "message":
                "No Wi-Fi device found",
        }

    if not wifi_enabled():
        return {
            "success": False,
            "message":
                "Wi-Fi is disabled",
        }

    protected = is_protected(
        security
    )

    previous_uuid = (
        active_uuid_for_device(
            device
        )
    )

    if hidden:
        return connect_hidden_network(
            ssid,
            device,
            password,
            security_mode or "wpa-psk",
            previous_uuid,
        )

    # Hidden networks may already have a saved profile
    # despite not appearing in the scan result.
    if not saved_uuid:
        matches = profiles_for_ssid(
            ssid
        )

        if matches:
            saved_uuid = (
                matches[0]["uuid"]
            )

    # --------------------------------------------------------
    # Existing profile
    # --------------------------------------------------------

    if saved_uuid:
        if hidden:
            run([
                "nmcli",
                "connection",
                "modify",
                "uuid",
                saved_uuid,
                "802-11-wireless.hidden",
                "yes",
            ])

        command = [
            "nmcli",
            "--wait",
            "18",
            "connection",
            "up",
            "uuid",
            saved_uuid,
            "ifname",
            device,
        ]

        if password:
            command.insert(
                1,
                "--ask"
            )

            code, message = (
                run_nmcli_with_secret(
                    command,
                    password,
                )
            )

            error = ""
            out = message

        else:
            code, out, error = run(
                command,
                timeout=22
            )

        if code == 0:
            return {
                "success": True,
                "message":
                    "Connected to " +
                    ssid,
            }

        restore_previous(
            previous_uuid,
            device
        )

        return {
            "success": False,
            "passwordRequired":
                protected,
            "message":
                error
                or out
                or "Connection failed",
        }

    # --------------------------------------------------------
    # New profile
    # --------------------------------------------------------

    if protected and not password:
        return {
            "success": False,
            "passwordRequired": True,
            "message": "Password required",
        }

    before = {
        profile["uuid"]
        for profile
        in profiles_for_ssid(ssid)
    }

    command = [
        "nmcli",
        "--wait",
        "18",
        "device",
        "wifi",
        "connect",
        ssid,
        "ifname",
        device,
        "name",
        ssid,
    ]

    if hidden:
        command += [
            "hidden",
            "yes",
        ]

    if protected:
        command.insert(
            1,
            "--ask"
        )

        code, out = (
            run_nmcli_with_secret(
                command,
                password,
            )
        )

        error = ""

    else:
        code, out, error = run(
            command,
            timeout=22
        )

    if code == 0:
        return {
            "success": True,
            "message":
                "Connected to " +
                ssid,
        }

    # Delete only a profile created by this FAILED attempt.
    after_profiles = (
        profiles_for_ssid(ssid)
    )

    for profile in after_profiles:
        if profile["uuid"] in before:
            continue

        run([
            "nmcli",
            "connection",
            "delete",
            "uuid",
            profile["uuid"],
        ])

    restore_previous(
        previous_uuid,
        device
    )

    return {
        "success": False,
        "passwordRequired":
            protected and not hidden,
        "message":
            error
            or out
            or "Connection failed",
    }

def action(payload):
    operation = str(
        payload.get("operation", "")
    )

    if operation == "connect":
        return connect_action(
            payload
        )

    if operation == "disconnect":
        device = str(
            payload.get(
                "device",
                ""
            )
        ).strip()

        if not device:
            return {
                "success": False,
                "message":
                    "No network device",
            }

        code, out, error = run([
            "nmcli",
            "--wait",
            "10",
            "device",
            "disconnect",
            device,
        ], timeout=12)

        return {
            "success": code == 0,
            "message":
                (
                    "Disconnected"
                    if code == 0
                    else (
                        error
                        or out
                        or "Disconnect failed"
                    )
                ),
        }

    if operation == "forget":
        uuid = str(
            payload.get(
                "uuid",
                ""
            )
        ).strip()

        if not uuid:
            return {
                "success": False,
                "message":
                    "Missing profile",
            }

        code, out, error = run([
            "nmcli",
            "connection",
            "delete",
            "uuid",
            uuid,
        ])

        return {
            "success": code == 0,
            "message":
                (
                    "Network forgotten"
                    if code == 0
                    else (
                        error
                        or out
                        or "Forget failed"
                    )
                ),
        }

    if operation == "wifi":
        enabled = bool(
            payload.get("enabled")
        )

        code, out, error = run([
            "nmcli",
            "radio",
            "wifi",
            "on" if enabled else "off",
        ])

        return {
            "success": code == 0,
            "message":
                (
                    "Wi-Fi enabled"
                    if (
                        code == 0
                        and enabled
                    )
                    else (
                        "Wi-Fi disabled"
                        if code == 0
                        else (
                            error
                            or out
                            or "Wi-Fi action failed"
                        )
                    )
                ),
        }

    return {
        "success": False,
        "message":
            "Unknown network action",
    }


def selftest():
    checks = {
        "nmcli":
            nmcli_exists(),
        "state":
            False,
        "list":
            False,
    }

    try:
        data = state()

        checks["state"] = isinstance(
            data,
            dict
        )

    except Exception:
        pass

    try:
        data = list_networks(
            rescan=False
        )

        checks["list"] = isinstance(
            data,
            list
        )

    except Exception:
        pass

    return {
        "ok": all(
            checks.values()
        ),
        "checks": checks,
    }


if len(sys.argv) < 2:
    output_json({
        "error": "Missing command"
    }, 1)


command = sys.argv[1]


if command == "state":
    output_json(
        state()
    )


if command == "list":
    output_json(
        list_networks(
            rescan=(
                "--rescan"
                in sys.argv[2:]
            )
        )
    )


if command == "action":
    try:
        # Quickshell writes one JSON request followed by newline.
        # Do NOT wait for EOF: the Process keeps stdin open.
        payload = json.loads(
            sys.stdin.readline()
            or "{}"
        )

    except Exception:
        output_json({
            "success": False,
            "message":
                "Invalid request",
        }, 1)

    result = action(payload)

    output_json(
        result,
        0 if result.get(
            "success"
        ) else 1
    )


if command == "selftest":
    result = selftest()

    output_json(
        result,
        0 if result["ok"] else 1
    )


output_json({
    "error": "Unknown command"
}, 1)
