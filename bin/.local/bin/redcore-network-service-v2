#!/usr/bin/env python3

import json
import signal
import sys
import time

import gi

gi.require_version("NM", "1.0")

from gi.repository import GLib, NM


class RedCoreNetworkService:
    VERSION = 2.3
    STALE_AP_SECONDS = 45
    SCAN_TIMEOUT_SECONDS = 15

    def __init__(self):
        self.client = NM.Client.new(None)
        self.loop = GLib.MainLoop()

        self.device_handlers = {}
        self.emit_source = None

        # iface -> {
        #   before: last_scan_ms,
        #   timeout: GLib source id
        # }
        self.pending_scans = {}

        # iface -> CLOCK_BOOTTIME seconds at which the most
        # recent successful Red Core scan was requested.
        #
        # This lets us remove cached APs without assuming that
        # AccessPoint.last_seen must equal DeviceWifi.last_scan.
        self.scan_fresh_after = {}

        # One UI network action at a time.
        self.pending_action = None
        self.activation_handlers = {}
        self.activation_timeout = None

        self.stdin_channel = None
        self.stdin_watch = None

        self.connect_signals()
        self.setup_stdin()

    # ========================================================
    # OUTPUT
    # ========================================================

    def send(self, data):
        print(
            json.dumps(
                data,
                ensure_ascii=False,
                separators=(",", ":"),
            ),
            flush=True,
        )

    def send_error(
        self,
        message,
        action="",
        device="",
    ):
        data = {
            "event": "error",
            "message": str(message),
        }

        if action:
            data["action"] = action

        if device:
            data["device"] = device

        self.send(data)

    # ========================================================
    # SNAPSHOT DEBOUNCE
    # ========================================================

    def schedule_snapshot(self, *args):
        if self.emit_source is not None:
            return

        self.emit_source = GLib.timeout_add(
            120,
            self.emit_snapshot,
        )

    def emit_snapshot(self):
        self.emit_source = None

        try:
            self.send({
                "event": "snapshot",
                "data": self.snapshot(),
            })

        except Exception as exc:
            self.send_error(exc)

        return GLib.SOURCE_REMOVE

    # ========================================================
    # HELPERS
    # ========================================================

    @staticmethod
    def ssid_text(ssid):
        if ssid is None:
            return ""

        try:
            return (
                ssid.get_data()
                .decode(
                    "utf-8",
                    errors="replace",
                )
            )

        except Exception:
            return ""

    @staticmethod
    def device_state_name(state):
        try:
            value = int(state)
        except Exception:
            return "unknown"

        names = {
            int(NM.DeviceState.UNKNOWN):
                "unknown",

            int(NM.DeviceState.UNMANAGED):
                "unmanaged",

            int(NM.DeviceState.UNAVAILABLE):
                "unavailable",

            int(NM.DeviceState.DISCONNECTED):
                "disconnected",

            int(NM.DeviceState.PREPARE):
                "prepare",

            int(NM.DeviceState.CONFIG):
                "config",

            int(NM.DeviceState.NEED_AUTH):
                "need-auth",

            int(NM.DeviceState.IP_CONFIG):
                "ip-config",

            int(NM.DeviceState.IP_CHECK):
                "ip-check",

            int(NM.DeviceState.SECONDARIES):
                "secondaries",

            int(NM.DeviceState.ACTIVATED):
                "activated",

            int(NM.DeviceState.DEACTIVATING):
                "deactivating",

            int(NM.DeviceState.FAILED):
                "failed",
        }

        return names.get(
            value,
            str(value),
        )

    @staticmethod
    def security_name(ap):
        flags = int(ap.get_flags())
        wpa = int(ap.get_wpa_flags())
        rsn = int(ap.get_rsn_flags())

        try:
            privacy_flag = int(
                NM._80211ApFlags.PRIVACY
            )
        except Exception:
            privacy_flag = 1

        try:
            sae_flag = int(
                NM._80211ApSecurityFlags
                .KEY_MGMT_SAE
            )
        except Exception:
            sae_flag = 0

        try:
            owe_flag = int(
                NM._80211ApSecurityFlags
                .KEY_MGMT_OWE
            )
        except Exception:
            owe_flag = 0

        if (
            sae_flag and
            rsn & sae_flag
        ):
            return "WPA3"

        if (
            owe_flag and
            rsn & owe_flag
        ):
            return "OWE"

        if rsn:
            return "WPA2"

        if wpa:
            return "WPA"

        if flags & privacy_flag:
            return "WEP"

        return "Open"

    def find_wifi_device(self, iface):
        for device in (
            self.client.get_devices()
            or []
        ):
            if (
                isinstance(
                    device,
                    NM.DeviceWifi,
                )
                and
                device.get_iface() == iface
            ):
                return device

        return None

    # ========================================================
    # CONNECTION PROFILES
    # ========================================================

    def wifi_profiles(self):
        result = []

        for connection in (
            self.client.get_connections()
            or []
        ):
            try:
                if (
                    connection.get_connection_type()
                    != "802-11-wireless"
                ):
                    continue

                setting = (
                    connection
                    .get_setting_wireless()
                )

                if setting is None:
                    continue

                ssid = self.ssid_text(
                    setting.get_ssid()
                )

                if not ssid:
                    continue

                result.append({
                    "ssid": ssid,
                    "uuid":
                        connection.get_uuid()
                        or "",
                    "id":
                        connection.get_id()
                        or ssid,
                })

            except Exception:
                continue

        return result


    def profiles_for_ssid(
        self,
        ssid,
    ):
        return [
            profile
            for profile in
            self.wifi_profiles()
            if profile["ssid"] == ssid
        ]


    def find_access_point(
        self,
        device,
        ssid,
    ):
        best = None

        for ap in (
            device.get_access_points()
            or []
        ):
            if (
                self.ssid_text(
                    ap.get_ssid()
                )
                != ssid
            ):
                continue

            if (
                best is None
                or ap.get_strength()
                > best.get_strength()
            ):
                best = ap

        return best


    def active_uuid_for_device(
        self,
        device,
    ):
        try:
            active = (
                device
                .get_active_connection()
            )
        except Exception:
            active = None

        if active is None:
            return ""

        try:
            path = (
                active.get_connection()
                or ""
            )
        except Exception:
            return ""

        return self.connection_uuid_from_path(
            path
        )


    def restore_previous_done(
        self,
        client,
        result,
        user_data,
    ):
        try:
            client.activate_connection_finish(
                result
            )
        except Exception:
            pass


    def restore_previous_for_pending(
        self,
    ):
        action = (
            self.pending_action
            or {}
        )

        uuid = str(
            action.get(
                "previousUuid",
                "",
            )
        )

        iface = str(
            action.get(
                "device",
                "",
            )
        )

        if not uuid or not iface:
            return

        connection = (
            self.client
            .get_connection_by_uuid(
                uuid
            )
        )

        device = (
            self.client
            .get_device_by_iface(
                iface
            )
        )

        if (
            connection is None or
            device is None
        ):
            return

        try:
            self.client.activate_connection_async(
                connection,
                device,
                None,
                None,
                self.restore_previous_done,
                None,
            )
        except Exception:
            pass


    def connection_uuid_from_path(
        self,
        path,
    ):
        if not path:
            return ""

        connection = (
            self.client
            .get_connection_by_path(
                path
            )
        )

        if connection is None:
            return ""

        return (
            connection.get_uuid()
            or ""
        )


    def delete_connection_path(
        self,
        path,
    ):
        if not path:
            return

        connection = (
            self.client
            .get_connection_by_path(
                path
            )
        )

        if connection is None:
            return

        try:
            connection.delete_async(
                None,
                self.delete_cleanup_done,
                None,
            )
        except Exception:
            pass


    def delete_cleanup_done(
        self,
        connection,
        result,
        user_data,
    ):
        try:
            connection.delete_finish(
                result
            )
        except Exception:
            pass


    def delete_uuid_quiet(
        self,
        uuid,
    ):
        if not uuid:
            return

        connection = (
            self.client
            .get_connection_by_uuid(
                uuid
            )
        )

        if connection is None:
            return

        try:
            connection.delete_async(
                None,
                self.delete_cleanup_done,
                None,
            )
        except Exception:
            pass


    # ========================================================
    # BUILD WIFI CONNECTION
    # ========================================================

    def build_wifi_connection(
        self,
        ssid,
        password,
        security_mode,
        hidden,
    ):
        connection = (
            NM.SimpleConnection.new()
        )

        setting_connection = (
            NM.SettingConnection.new()
        )

        setting_connection.set_property(
            "id",
            ssid,
        )

        setting_connection.set_property(
            "type",
            "802-11-wireless",
        )

        setting_connection.set_property(
            "autoconnect",
            True,
        )

        connection.add_setting(
            setting_connection
        )


        setting_wifi = (
            NM.SettingWireless.new()
        )

        setting_wifi.set_property(
            "ssid",
            GLib.Bytes.new(
                ssid.encode("utf-8")
            ),
        )

        setting_wifi.set_property(
            "mode",
            "infrastructure",
        )

        setting_wifi.set_property(
            "hidden",
            bool(hidden),
        )

        connection.add_setting(
            setting_wifi
        )


        if security_mode != "open":
            security = (
                NM.SettingWirelessSecurity.new()
            )

            if security_mode == "sae":
                security.set_property(
                    "key-mgmt",
                    "sae",
                )

            else:
                security.set_property(
                    "key-mgmt",
                    "wpa-psk",
                )

            security.set_property(
                "psk",
                password,
            )

            connection.add_setting(
                security
            )


        ipv4 = (
            NM.SettingIP4Config.new()
        )

        ipv4.set_property(
            "method",
            "auto",
        )

        connection.add_setting(
            ipv4
        )


        ipv6 = (
            NM.SettingIP6Config.new()
        )

        ipv6.set_property(
            "method",
            "auto",
        )

        connection.add_setting(
            ipv6
        )

        return connection


    # ========================================================
    # ACTION RESULT / ACTIVATION TRACKING
    # ========================================================

    def clear_activation_watch(self):
        if self.activation_timeout:
            try:
                GLib.source_remove(
                    self.activation_timeout
                )
            except Exception:
                pass

            self.activation_timeout = None

        for path, item in list(
            self.activation_handlers.items()
        ):
            active, handler = item

            try:
                active.disconnect(
                    handler
                )
            except Exception:
                pass

        self.activation_handlers.clear()


    def finish_action(
        self,
        success,
        message,
        **extra,
    ):
        action = (
            self.pending_action
            or {}
        )

        data = {
            "event":
                "action-result",

            "action":
                action.get(
                    "action",
                    "",
                ),

            "success":
                bool(success),

            "message":
                message,
        }

        request_id = (
            action.get("requestId")
        )

        if request_id is not None:
            data["requestId"] = (
                request_id
            )

        data.update(extra)

        self.send(data)

        self.pending_action = None

        self.clear_activation_watch()
        self.schedule_snapshot()


    def activation_timeout_cb(self):
        self.activation_timeout = None

        action = (
            self.pending_action
            or {}
        )

        created_path = (
            action.get(
                "createdPath",
                "",
            )
        )

        if created_path:
            self.delete_connection_path(
                created_path
            )

        self.restore_previous_for_pending()

        self.finish_action(
            False,
            "Connection timed out",
        )

        return GLib.SOURCE_REMOVE


    def watch_activation(
        self,
        active,
    ):
        path = active.get_path()

        handler = active.connect(
            "notify::state",
            self.activation_state_changed,
        )

        self.activation_handlers[
            path
        ] = (
            active,
            handler,
        )

        self.activation_timeout = (
            GLib.timeout_add_seconds(
                30,
                self.activation_timeout_cb,
            )
        )

        # Check the state immediately too.
        self.activation_state_changed(
            active,
            None,
        )


    def activation_state_changed(
        self,
        active,
        pspec,
    ):
        if self.pending_action is None:
            return

        try:
            state = active.get_state()
        except Exception:
            return

        if (
            state ==
            NM.ActiveConnectionState.ACTIVATED
        ):
            action = self.pending_action

            old_uuid = (
                action.get(
                    "replaceUuid",
                    "",
                )
            )

            created_path = (
                action.get(
                    "createdPath",
                    "",
                )
            )

            created_uuid = (
                self.connection_uuid_from_path(
                    created_path
                )
            )

            # Password retry:
            # keep old saved profile until the new
            # profile actually connected successfully.
            if (
                old_uuid
                and created_uuid
                and old_uuid != created_uuid
            ):
                self.delete_uuid_quiet(
                    old_uuid
                )

            self.finish_action(
                True,
                "Connected",
            )

            return


        if (
            state ==
            NM.ActiveConnectionState.DEACTIVATED
        ):
            action = self.pending_action

            created_path = (
                action.get(
                    "createdPath",
                    "",
                )
            )

            if created_path:
                self.delete_connection_path(
                    created_path
                )

            self.restore_previous_for_pending()

            protected = bool(
                action.get(
                    "protected",
                    False,
                )
            )

            self.finish_action(
                False,
                "Connection failed",
                passwordRequired=
                    protected,
            )


    # ========================================================
    # CONNECT
    # ========================================================

    def activate_saved_done(
        self,
        client,
        result,
        user_data,
    ):
        try:
            active = (
                client
                .activate_connection_finish(
                    result
                )
            )

        except Exception as exc:
            protected = bool(
                (
                    self.pending_action
                    or {}
                ).get(
                    "protected",
                    False,
                )
            )

            self.restore_previous_for_pending()

            self.finish_action(
                False,
                str(exc),
                passwordRequired=
                    protected,
            )

            return

        self.watch_activation(
            active
        )


    def add_activate_done(
        self,
        client,
        result,
        user_data,
    ):
        try:
            active = (
                client
                .add_and_activate_connection_finish(
                    result
                )
            )

        except Exception as exc:
            self.restore_previous_for_pending()

            self.finish_action(
                False,
                str(exc),
                passwordRequired=
                    bool(
                        (
                            self.pending_action
                            or {}
                        ).get(
                            "protected",
                            False,
                        )
                    ),
            )

            return

        if self.pending_action is not None:
            try:
                self.pending_action[
                    "createdPath"
                ] = (
                    active.get_connection()
                    or ""
                )
            except Exception:
                self.pending_action[
                    "createdPath"
                ] = ""

        self.watch_activation(
            active
        )


    def action_connect(
        self,
        command,
    ):
        if self.pending_action is not None:
            self.send_error(
                "Another network action is running",
                action="connect",
            )
            return

        iface = str(
            command.get(
                "device",
                "",
            )
        ).strip()

        ssid = str(
            command.get(
                "ssid",
                "",
            )
        ).strip()

        password = str(
            command.get(
                "password",
                "",
            )
        )

        saved_uuid = str(
            command.get(
                "savedUuid",
                "",
            )
        ).strip()

        hidden = bool(
            command.get(
                "hidden",
                False,
            )
        )

        security_mode = str(
            command.get(
                "securityMode",
                "",
            )
        ).strip().lower()

        if security_mode not in {
            "open",
            "wpa-psk",
            "sae",
        }:
            security_label = str(
                command.get(
                    "security",
                    "",
                )
            ).strip().upper()

            if security_label in {
                "",
                "--",
                "OPEN",
            }:
                security_mode = "open"

            elif "WPA3" in security_label:
                security_mode = "sae"

            elif security_label in {
                "WPA",
                "WPA2",
                "WPA/WPA2",
            }:
                security_mode = "wpa-psk"

            else:
                self.send({
                    "event":
                        "action-result",

                    "action":
                        "connect",

                    "requestId":
                        command.get(
                            "requestId"
                        ),

                    "success":
                        False,

                    "message":
                        "Unsupported Wi-Fi security type",
                })

                return

        protected = (
            security_mode != "open"
        )

        if not iface:
            self.send_error(
                "Missing Wi-Fi adapter",
                action="connect",
            )
            return

        if not ssid:
            self.send_error(
                "Missing SSID",
                action="connect",
                device=iface,
            )
            return

        if not saved_uuid:
            matches = (
                self.profiles_for_ssid(
                    ssid
                )
            )

            if matches:
                saved_uuid = (
                    matches[0]["uuid"]
                )

        device = (
            self.find_wifi_device(
                iface
            )
        )

        if device is None:
            self.send_error(
                "Wi-Fi adapter not found",
                action="connect",
                device=iface,
            )
            return

        previous_uuid = (
            self.active_uuid_for_device(
                device
            )
        )

        ap = None

        if not hidden:
            ap = (
                self.find_access_point(
                    device,
                    ssid,
                )
            )

            if ap is None:
                self.send_error(
                    "Network is no longer available",
                    action="connect",
                    device=iface,
                )
                return


        # If a saved profile exists and the user
        # did not supply a new password, let
        # NetworkManager activate its saved secret.
        if saved_uuid and not password:
            connection = (
                self.client
                .get_connection_by_uuid(
                    saved_uuid
                )
            )

            if connection is not None:
                self.pending_action = {
                    "action":
                        "connect",

                    "requestId":
                        command.get(
                            "requestId"
                        ),

                    "device":
                        iface,

                    "ssid":
                        ssid,

                    "protected":
                        protected,

                    "previousUuid":
                        previous_uuid,

                    "replaceUuid":
                        "",
                }

                try:
                    self.client.activate_connection_async(
                        connection,
                        device,
                        (
                            ap.get_path()
                            if ap is not None
                            else None
                        ),
                        None,
                        self.activate_saved_done,
                        None,
                    )

                except Exception as exc:
                    self.finish_action(
                        False,
                        str(exc),
                        passwordRequired=
                            protected,
                    )

                return


        if (
            protected
            and not password
        ):
            self.send({
                "event":
                    "action-result",

                "action":
                    "connect",

                "requestId":
                    command.get(
                        "requestId"
                    ),

                "success":
                    False,

                "passwordRequired":
                    True,

                "message":
                    "Password required",
            })

            return


        connection = (
            self.build_wifi_connection(
                ssid,
                password,
                security_mode,
                hidden,
            )
        )

        self.pending_action = {
            "action":
                "connect",

            "requestId":
                command.get(
                    "requestId"
                ),

            "device":
                iface,

            "ssid":
                ssid,

            "protected":
                protected,

            "previousUuid":
                previous_uuid,

            # If a saved connection failed and the
            # user typed a new password, replace it
            # only AFTER successful activation.
            "replaceUuid":
                saved_uuid,

            "createdPath":
                "",
        }

        try:
            self.client.add_and_activate_connection_async(
                connection,
                device,
                (
                    ap.get_path()
                    if ap is not None
                    else None
                ),
                None,
                self.add_activate_done,
                None,
            )

        except Exception as exc:
            self.finish_action(
                False,
                str(exc),
                passwordRequired=
                    protected,
            )

        # Remove our local Python reference to
        # the plaintext as soon as possible.
        password = ""


    # ========================================================
    # DISCONNECT
    # ========================================================

    def disconnect_done(
        self,
        client,
        result,
        user_data,
    ):
        try:
            ok = (
                client
                .deactivate_connection_finish(
                    result
                )
            )

            self.finish_action(
                bool(ok),
                (
                    "Disconnected"
                    if ok
                    else "Disconnect failed"
                ),
            )

        except Exception as exc:
            self.finish_action(
                False,
                str(exc),
            )


    def action_disconnect(
        self,
        command,
    ):
        if self.pending_action is not None:
            self.send_error(
                "Another network action is running",
                action="disconnect",
            )
            return

        iface = str(
            command.get(
                "device",
                "",
            )
        ).strip()

        device = (
            self.find_wifi_device(
                iface
            )
        )

        if device is None:
            # Ethernet can also be disconnected.
            for candidate in (
                self.client.get_devices()
                or []
            ):
                if (
                    candidate.get_iface()
                    == iface
                ):
                    device = candidate
                    break

        if device is None:
            self.send_error(
                "Network device not found",
                action="disconnect",
                device=iface,
            )
            return

        active = (
            device.get_active_connection()
        )

        if active is None:
            self.send({
                "event":
                    "action-result",
                "action":
                    "disconnect",
                "success":
                    True,
                "message":
                    "Already disconnected",
            })
            return

        self.pending_action = {
            "action":
                "disconnect",
            "requestId":
                command.get(
                    "requestId"
                ),
        }

        try:
            self.client.deactivate_connection_async(
                active,
                None,
                self.disconnect_done,
                None,
            )

        except Exception as exc:
            self.finish_action(
                False,
                str(exc),
            )


    # ========================================================
    # FORGET
    # ========================================================

    def forget_done(
        self,
        connection,
        result,
        user_data,
    ):
        try:
            ok = (
                connection.delete_finish(
                    result
                )
            )

            self.finish_action(
                bool(ok),
                (
                    "Network forgotten"
                    if ok
                    else "Forget failed"
                ),
            )

        except Exception as exc:
            self.finish_action(
                False,
                str(exc),
            )


    def action_forget(
        self,
        command,
    ):
        if self.pending_action is not None:
            self.send_error(
                "Another network action is running",
                action="forget",
            )
            return

        uuid = str(
            command.get(
                "uuid",
                "",
            )
        ).strip()

        connection = (
            self.client
            .get_connection_by_uuid(
                uuid
            )
        )

        if connection is None:
            self.send({
                "event":
                    "action-result",
                "action":
                    "forget",
                "success":
                    True,
                "message":
                    "Profile already removed",
            })
            return

        self.pending_action = {
            "action":
                "forget",
            "requestId":
                command.get(
                    "requestId"
                ),
        }

        try:
            connection.delete_async(
                None,
                self.forget_done,
                None,
            )

        except Exception as exc:
            self.finish_action(
                False,
                str(exc),
            )


    # ========================================================
    # WIFI RADIO
    # ========================================================

    def action_wifi(
        self,
        command,
    ):
        enabled = bool(
            command.get(
                "enabled",
                True,
            )
        )

        try:
            self.client.wireless_set_enabled(
                enabled
            )

            self.send({
                "event":
                    "action-result",

                "action":
                    "wifi",

                "requestId":
                    command.get(
                        "requestId"
                    ),

                "success":
                    True,

                "message":
                    (
                        "Wi-Fi enabled"
                        if enabled
                        else "Wi-Fi disabled"
                    ),
            })

            self.schedule_snapshot()

        except Exception as exc:
            self.send({
                "event":
                    "action-result",

                "action":
                    "wifi",

                "requestId":
                    command.get(
                        "requestId"
                    ),

                "success":
                    False,

                "message":
                    str(exc),
            })


    # ========================================================
    # IP INFORMATION
    # ========================================================

    def ip4_info(
        self,
        device,
    ):
        result = {
            "ipAddress": "",
            "gateway": "",
        }

        try:
            config = (
                device.get_ip4_config()
            )
        except Exception:
            config = None

        if config is None:
            return result

        try:
            addresses = (
                config.get_addresses()
                or []
            )

            if addresses:
                address = addresses[0]

                result["ipAddress"] = (
                    str(
                        address.get_address()
                        or ""
                    )
                    +
                    (
                        "/" +
                        str(
                            address.get_prefix()
                        )
                        if address.get_address()
                        else ""
                    )
                )

        except Exception:
            pass

        try:
            result["gateway"] = (
                config.get_gateway()
                or ""
            )
        except Exception:
            pass

        return result


    # ========================================================
    # PRIMARY CONNECTION
    # ========================================================

    def primary_info(self):
        primary = (
            self.client
            .get_primary_connection()
        )

        if primary is None:
            return {
                "connected": False,
                "id": "",
                "uuid": "",
                "type": "none",
                "devices": [],
            }

        devices = [
            device.get_iface()
            for device in (
                primary.get_devices()
                or []
            )
        ]

        return {
            "connected": True,

            "id":
                primary.get_id()
                or "",

            "uuid":
                primary.get_uuid()
                or "",

            "type":
                primary.get_connection_type()
                or "none",

            "devices":
                devices,
        }

    # ========================================================
    # WIFI ACCESS POINTS
    # ========================================================

    def wifi_access_points(
        self,
        device,
    ):
        active_ap = (
            device
            .get_active_access_point()
        )

        try:
            last_scan_ms = int(
                device.get_last_scan()
            )
        except Exception:
            last_scan_ms = -1

        last_scan_sec = (
            last_scan_ms // 1000
            if last_scan_ms >= 0
            else -1
        )

        try:
            now_boot_sec = int(
                time.clock_gettime(
                    time.CLOCK_BOOTTIME
                )
            )
        except Exception:
            now_boot_sec = 0

        rows = {}

        for ap in (
            device.get_access_points()
            or []
        ):
            ssid = self.ssid_text(
                ap.get_ssid()
            )

            # Blank SSIDs belong in the explicit
            # Hidden Network workflow instead.
            if not ssid:
                continue

            try:
                last_seen = int(
                    ap.get_last_seen()
                )
            except Exception:
                last_seen = -1

            fresh = True

            if ap != active_ap:
                iface = device.get_iface()

                fresh_after = (
                    self.scan_fresh_after.get(
                        iface
                    )
                )

                if (
                    fresh_after is not None and
                    last_seen >= 0
                ):
                    # A Red Core scan completed successfully.
                    #
                    # Keep APs that NetworkManager actually
                    # observed since that scan began.
                    #
                    # Small tolerance handles scheduling
                    # differences between the scan request and
                    # NetworkManager updating LastSeen.
                    fresh = (
                        last_seen >=
                        fresh_after - 2
                    )

                elif (
                    last_seen >= 0 and
                    now_boot_sec > 0
                ):
                    # Before Red Core has completed its first
                    # scan, tolerate NetworkManager's initial
                    # cache for a short period.
                    age = (
                        now_boot_sec -
                        last_seen
                    )

                    fresh = (
                        age <=
                        self.STALE_AP_SECONDS
                    )

            if not fresh:
                continue

            strength = int(
                ap.get_strength()
            )

            saved_profiles = (
                self.profiles_for_ssid(
                    ssid
                )
            )

            row = {
                "ssid": ssid,
                "strength": strength,

                "security":
                    self.security_name(ap),

                "active":
                    ap == active_ap,

                "saved":
                    len(saved_profiles) > 0,

                "savedUuid":
                    (
                        saved_profiles[0]["uuid"]
                        if saved_profiles
                        else ""
                    ),

                "lastSeen":
                    last_seen,

                "bssid":
                    ap.get_bssid()
                    or "",
            }

            current = rows.get(ssid)

            # One visible row per SSID per adapter:
            # active BSSID wins, otherwise strongest.
            if (
                current is None
                or row["active"]
                or (
                    not current["active"]
                    and strength >
                    current["strength"]
                )
            ):
                rows[ssid] = row

        result = list(
            rows.values()
        )

        result.sort(
            key=lambda item: (
                not item["active"],
                -item["strength"],
                item["ssid"].lower(),
            )
        )

        return result

    # ========================================================
    # DEVICE SNAPSHOTS
    # ========================================================

    def wifi_device_info(
        self,
        device,
    ):
        active_ap = (
            device
            .get_active_access_point()
        )

        active_ssid = ""

        if active_ap is not None:
            active_ssid = (
                self.ssid_text(
                    active_ap.get_ssid()
                )
            )

        try:
            last_scan_ms = int(
                device.get_last_scan()
            )
        except Exception:
            last_scan_ms = -1

        iface = device.get_iface()

        ip4 = self.ip4_info(
            device
        )

        return {
            "type": "wifi",
            "iface": iface,

            "ipAddress":
                ip4["ipAddress"],

            "gateway":
                ip4["gateway"],

            "state":
                self.device_state_name(
                    device.get_state()
                ),

            "activeSsid":
                active_ssid,

            "lastScanMs":
                last_scan_ms,

            "scanBusy":
                iface in
                self.pending_scans,

            "accessPoints":
                self.wifi_access_points(
                    device
                ),
        }

    def ethernet_device_info(
        self,
        device,
    ):
        try:
            carrier = bool(
                device.get_carrier()
            )
        except Exception:
            carrier = False

        ip4 = self.ip4_info(
            device
        )

        return {
            "type": "ethernet",

            "iface":
                device.get_iface(),

            "ipAddress":
                ip4["ipAddress"],

            "gateway":
                ip4["gateway"],

            "state":
                self.device_state_name(
                    device.get_state()
                ),

            "carrier":
                carrier,
        }

    # ========================================================
    # COMPLETE SNAPSHOT
    # ========================================================

    def snapshot(self):
        wifi_devices = []
        ethernet_devices = []

        for device in (
            self.client.get_devices()
            or []
        ):
            if isinstance(
                device,
                NM.DeviceWifi,
            ):
                wifi_devices.append(
                    self.wifi_device_info(
                        device
                    )
                )

            elif isinstance(
                device,
                NM.DeviceEthernet,
            ):
                # Do not clutter the popup with built-in
                # Ethernet ports while no cable is attached.
                try:
                    carrier = bool(
                        device.get_carrier()
                    )
                except Exception:
                    carrier = False

                if carrier:
                    ethernet_devices.append(
                        self.ethernet_device_info(
                            device
                        )
                    )

        wifi_devices.sort(
            key=lambda item:
                item["iface"]
        )

        ethernet_devices.sort(
            key=lambda item:
                item["iface"]
        )

        return {
            "nmRunning":
                bool(
                    self.client
                    .get_nm_running()
                ),

            "wifiEnabled":
                bool(
                    self.client
                    .wireless_get_enabled()
                ),

            "wifiHardwareEnabled":
                bool(
                    self.client
                    .wireless_hardware_get_enabled()
                ),

            "primary":
                self.primary_info(),

            "wifi":
                wifi_devices,

            "ethernet":
                ethernet_devices,
        }

    # ========================================================
    # SCANNING
    # ========================================================

    def clear_scan(
        self,
        iface,
    ):
        pending = (
            self.pending_scans.pop(
                iface,
                None,
            )
        )

        if pending is None:
            return

        timeout_source = (
            pending.get("timeout")
        )

        if timeout_source:
            try:
                GLib.source_remove(
                    timeout_source
                )
            except Exception:
                pass

    def scan_timeout(
        self,
        iface,
    ):
        if (
            iface not in
            self.pending_scans
        ):
            return GLib.SOURCE_REMOVE

        self.pending_scans.pop(
            iface,
            None,
        )

        self.send({
            "event": "scan-timeout",
            "device": iface,
            "success": False,
        })

        self.schedule_snapshot()

        return GLib.SOURCE_REMOVE

    def scan_finished_signal(
        self,
        device,
        pspec,
    ):
        iface = device.get_iface()

        pending = (
            self.pending_scans.get(
                iface
            )
        )

        if pending is not None:
            try:
                current = int(
                    device.get_last_scan()
                )
            except Exception:
                current = -1

            before = pending["before"]

            if (
                current >= 0 and
                current != before
            ):
                started_sec = int(
                    pending.get(
                        "startedSec",
                        0
                    )
                )

                if started_sec > 0:
                    self.scan_fresh_after[
                        iface
                    ] = started_sec

                self.clear_scan(
                    iface
                )

                self.send({
                    "event":
                        "scan-completed",

                    "device":
                        iface,

                    "success":
                        True,

                    "lastScanMs":
                        current,
                })

        self.schedule_snapshot()

    def scan_request_done(
        self,
        device,
        result,
        iface,
    ):
        try:
            accepted = bool(
                device.request_scan_finish(
                    result
                )
            )

            self.send({
                "event":
                    "scan-request",

                "device":
                    iface,

                "success":
                    accepted,
            })

            if not accepted:
                self.clear_scan(
                    iface
                )

        except Exception as exc:
            self.clear_scan(
                iface
            )

            self.send({
                "event":
                    "scan-request",

                "device":
                    iface,

                "success":
                    False,

                "message":
                    str(exc),
            })

        self.schedule_snapshot()

    def request_scan(
        self,
        iface,
    ):
        device = self.find_wifi_device(
            iface
        )

        if device is None:
            self.send_error(
                "Wi-Fi adapter not found",
                action="scan",
                device=iface,
            )
            return

        if (
            iface in
            self.pending_scans
        ):
            self.send({
                "event": "scan-request",
                "device": iface,
                "success": False,
                "busy": True,
                "message":
                    "Scan already running",
            })
            return

        try:
            before = int(
                device.get_last_scan()
            )
        except Exception:
            before = -1

        timeout_source = (
            GLib.timeout_add_seconds(
                self.SCAN_TIMEOUT_SECONDS,
                self.scan_timeout,
                iface,
            )
        )

        try:
            started_sec = int(
                time.clock_gettime(
                    time.CLOCK_BOOTTIME
                )
            )
        except Exception:
            started_sec = 0

        self.pending_scans[
            iface
        ] = {
            "before": before,

            "startedSec":
                started_sec,

            "timeout":
                timeout_source,
        }

        self.send({
            "event": "scan-started",
            "device": iface,
        })

        self.schedule_snapshot()

        try:
            device.request_scan_async(
                None,
                self.scan_request_done,
                iface,
            )

        except Exception as exc:
            self.clear_scan(
                iface
            )

            self.send({
                "event":
                    "scan-request",

                "device":
                    iface,

                "success":
                    False,

                "message":
                    str(exc),
            })

            self.schedule_snapshot()

    def request_scan_all(self):
        adapters = []

        for device in (
            self.client.get_devices()
            or []
        ):
            if isinstance(
                device,
                NM.DeviceWifi,
            ):
                adapters.append(
                    device.get_iface()
                )

        if not adapters:
            self.send_error(
                "No Wi-Fi adapters found",
                action="scan-all",
            )
            return

        self.send({
            "event": "scan-all-started",
            "devices": adapters,
        })

        for iface in adapters:
            self.request_scan(
                iface
            )

    # ========================================================
    # IPC
    # ========================================================

    def handle_command(
        self,
        line,
    ):
        line = line.strip()

        if not line:
            return

        try:
            command = json.loads(
                line
            )

        except Exception as exc:
            self.send_error(
                "Invalid JSON: " +
                str(exc)
            )
            return

        if not isinstance(
            command,
            dict,
        ):
            self.send_error(
                "Command must be a JSON object"
            )
            return

        action = str(
            command.get(
                "action",
                "",
            )
        ).strip()

        if action == "snapshot":
            self.emit_snapshot()
            return

        if action == "scan":
            iface = str(
                command.get(
                    "device",
                    "",
                )
            ).strip()

            if not iface:
                self.send_error(
                    "Missing Wi-Fi adapter",
                    action="scan",
                )
                return

            self.request_scan(
                iface
            )
            return

        if action == "scan-all":
            self.request_scan_all()
            return

        if action == "connect":
            self.action_connect(
                command
            )
            return

        if action == "disconnect":
            self.action_disconnect(
                command
            )
            return

        if action == "forget":
            self.action_forget(
                command
            )
            return

        if action == "wifi":
            self.action_wifi(
                command
            )
            return

        if action == "ping":
            self.send({
                "event": "pong",
                "version": self.VERSION,
            })
            return

        self.send_error(
            "Unknown action: " +
            action
        )

    def stdin_ready(
        self,
        channel,
        condition,
    ):
        if condition & (
            GLib.IO_HUP |
            GLib.IO_ERR
        ):
            self.loop.quit()
            return False

        try:
            (
                status,
                line,
                length,
                terminator,
            ) = channel.read_line()

        except Exception as exc:
            self.send_error(
                "IPC read failed: " +
                str(exc)
            )
            return True

        if (
            status ==
            GLib.IOStatus.EOF
        ):
            self.loop.quit()
            return False

        if (
            status ==
            GLib.IOStatus.NORMAL
            and line is not None
        ):
            self.handle_command(
                line
            )

        return True

    def setup_stdin(self):
        self.stdin_channel = (
            GLib.IOChannel.unix_new(
                sys.stdin.fileno()
            )
        )

        self.stdin_channel.set_encoding(
            "utf-8"
        )

        self.stdin_watch = (
            GLib.io_add_watch(
                self.stdin_channel,
                GLib.PRIORITY_DEFAULT,
                GLib.IO_IN |
                GLib.IO_HUP |
                GLib.IO_ERR,
                self.stdin_ready,
            )
        )

    # ========================================================
    # NETWORKMANAGER SIGNALS
    # ========================================================

    def connect_device_signals(
        self,
        device,
    ):
        path = device.get_path()

        if (
            path in
            self.device_handlers
        ):
            return

        handlers = []

        handlers.append(
            device.connect(
                "notify::state",
                self.schedule_snapshot,
            )
        )

        if isinstance(
            device,
            NM.DeviceWifi,
        ):
            handlers.append(
                device.connect(
                    "access-point-added",
                    self.schedule_snapshot,
                )
            )

            handlers.append(
                device.connect(
                    "access-point-removed",
                    self.schedule_snapshot,
                )
            )

            handlers.append(
                device.connect(
                    "notify::active-access-point",
                    self.schedule_snapshot,
                )
            )

            handlers.append(
                device.connect(
                    "notify::last-scan",
                    self.scan_finished_signal,
                )
            )

        elif isinstance(
            device,
            NM.DeviceEthernet,
        ):
            handlers.append(
                device.connect(
                    "notify::carrier",
                    self.schedule_snapshot,
                )
            )

        self.device_handlers[
            path
        ] = (
            device,
            handlers,
        )

    def reconnect_devices(self):
        current_paths = set()

        for device in (
            self.client.get_devices()
            or []
        ):
            path = device.get_path()

            current_paths.add(
                path
            )

            self.connect_device_signals(
                device
            )

        for path in list(
            self.device_handlers
        ):
            if path in current_paths:
                continue

            device, handlers = (
                self.device_handlers.pop(
                    path
                )
            )

            iface = (
                device.get_iface()
            )

            self.clear_scan(
                iface
            )

            self.scan_fresh_after.pop(
                iface,
                None
            )

            for handler in handlers:
                try:
                    device.disconnect(
                        handler
                    )
                except Exception:
                    pass

    def devices_changed(
        self,
        *args,
    ):
        self.reconnect_devices()
        self.schedule_snapshot()

    def connect_signals(self):
        self.client.connect(
            "notify::primary-connection",
            self.schedule_snapshot,
        )

        self.client.connect(
            "notify::wireless-enabled",
            self.schedule_snapshot,
        )

        self.client.connect(
            "notify::wireless-hardware-enabled",
            self.schedule_snapshot,
        )

        self.client.connect(
            "device-added",
            self.devices_changed,
        )

        self.client.connect(
            "device-removed",
            self.devices_changed,
        )

        self.reconnect_devices()

    # ========================================================
    # START / STOP
    # ========================================================

    def stop(
        self,
        *args,
    ):
        self.loop.quit()

    def run(self):
        signal.signal(
            signal.SIGTERM,
            self.stop,
        )

        signal.signal(
            signal.SIGINT,
            self.stop,
        )

        self.send({
            "event": "ready",
            "version": self.VERSION,
        })

        self.emit_snapshot()
        self.loop.run()


if __name__ == "__main__":
    RedCoreNetworkService().run()
