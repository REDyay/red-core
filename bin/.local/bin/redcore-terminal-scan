#!/usr/bin/env python3

import configparser
import json
import os
import sys
from pathlib import Path

try:
    windows = json.loads(sys.argv[1])
except Exception:
    windows = []

SHELLS = {
    "sh", "bash", "zsh", "dash", "fish", "nu"
}

WRAPPERS = {
    "sudo", "doas", "env",
    "tmux", "screen"
}

KNOWN_TERMINALS = {
    "foot", "footclient", "foot-server",
    "kitty",
    "alacritty",
    "wezterm", "wezterm-gui",
    "ghostty",
    "konsole",
    "gnome-terminal",
    "gnome-terminal-server",
    "xfce4-terminal",
    "qterminal",
    "lxterminal",
    "tilix",
    "terminator",
}


def normalize(value):
    return (
        str(value)
        .strip()
        .lower()
        .replace("_", "-")
        .replace(" ", "-")
    )


# ------------------------------------------------------------
# Build TerminalEmulator desktop-entry cache once per scan.
# ------------------------------------------------------------

terminal_desktop_ids = set()

data_home = Path(
    os.environ.get(
        "XDG_DATA_HOME",
        Path.home() / ".local/share"
    )
)

data_dirs = [
    Path(item)
    for item in os.environ.get(
        "XDG_DATA_DIRS",
        "/usr/local/share:/usr/share"
    ).split(":")
    if item
]

for base in [data_home, *data_dirs]:
    directory = base / "applications"

    if not directory.exists():
        continue

    for file in directory.glob("*.desktop"):
        try:
            parser = configparser.ConfigParser(
                interpolation=None,
                strict=False
            )

            parser.read(
                file,
                encoding="utf-8"
            )

            if "Desktop Entry" not in parser:
                continue

            entry = parser["Desktop Entry"]

            categories = normalize(
                entry.get(
                    "Categories",
                    ""
                )
            )

            if "terminalemulator" not in categories:
                continue

            terminal_desktop_ids.add(
                normalize(file.stem)
            )

            startup = normalize(
                entry.get(
                    "StartupWMClass",
                    ""
                )
            )

            if startup:
                terminal_desktop_ids.add(startup)

        except Exception:
            pass


def is_terminal(app_id):
    target = normalize(app_id)

    if target in KNOWN_TERMINALS:
        return True

    if target in terminal_desktop_ids:
        return True

    for desktop_id in terminal_desktop_ids:
        if desktop_id.endswith("." + target):
            return True

    return False


def children(pid):
    try:
        path = Path(
            f"/proc/{pid}/task/{pid}/children"
        )

        return [
            int(value)
            for value in path.read_text().split()
        ]

    except Exception:
        return []


def descendants(root_pid):
    result = []
    stack = [(root_pid, 0)]
    visited = set()

    while stack:
        pid, depth = stack.pop()

        if pid in visited:
            continue

        visited.add(pid)

        for child in children(pid):
            result.append(
                (child, depth + 1)
            )

            stack.append(
                (child, depth + 1)
            )

    return result


def proc_info(pid):
    try:
        raw = Path(
            f"/proc/{pid}/stat"
        ).read_text()

        close = raw.rfind(")")

        if close < 0:
            return None

        name = raw[
            raw.find("(") + 1:close
        ]

        fields = raw[
            close + 2:
        ].split()

        return {
            "pid": pid,
            "name": name,

            # /proc/PID/stat:
            # state, ppid, pgrp, session,
            # tty_nr, tpgid...
            "pgrp": int(fields[2]),
            "tty": int(fields[4]),
            "tpgid": int(fields[5]),
        }

    except Exception:
        return None


def foreground_application(terminal_pid):
    processes = []

    for pid, depth in descendants(
        terminal_pid
    ):
        info = proc_info(pid)

        if info is None:
            continue

        info["depth"] = depth
        processes.append(info)

    # The actual foreground TTY process group.
    foreground = [
        process
        for process in processes
        if (
            process["tty"] != 0
            and process["tpgid"] > 0
            and process["pgrp"]
                == process["tpgid"]
        )
    ]

    # Prefer the top-level foreground program,
    # not helper subprocesses spawned by it.
    foreground.sort(
        key=lambda process: (
            process["depth"],
            process["pid"]
        )
    )

    for process in foreground:
        name = normalize(
            process["name"]
        )

        if (
            name in SHELLS
            or name in WRAPPERS
            or name in KNOWN_TERMINALS
        ):
            continue

        return process["name"]

    return ""


result = {}

for window in windows:
    try:
        window_id = str(window["id"])
        app_id = str(
            window.get("app_id", "")
        )

        if not is_terminal(app_id):
            continue

        pid = int(window.get("pid", 0))

        if pid <= 0:
            result[window_id] = ""
            continue

        result[window_id] = (
            foreground_application(pid)
        )

    except Exception:
        continue

print(
    json.dumps(
        result,
        ensure_ascii=False
    )
)
