#!/usr/bin/env python3

import ctypes
import os
import signal
import sys

# Linux PR_SET_PDEATHSIG:
# automatically terminate this monitor if Quickshell dies.
PR_SET_PDEATHSIG = 1

try:
    libc = ctypes.CDLL(None, use_errno=True)

    result = libc.prctl(
        PR_SET_PDEATHSIG,
        signal.SIGTERM,
        0,
        0,
        0
    )

    if result != 0:
        raise OSError(
            ctypes.get_errno()
        )

except Exception:
    # Monitoring can still work without this protection;
    # cleanup/restart logic remains available.
    pass

# Protect against parent dying between process creation
# and PR_SET_PDEATHSIG.
if os.getppid() == 1:
    sys.exit(0)

os.execvp(
    "nmcli",
    [
        "nmcli",
        "monitor"
    ]
)
