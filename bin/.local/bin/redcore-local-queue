#!/usr/bin/env python3

import json
import socket
import sys
from pathlib import Path
from urllib.parse import urlparse, unquote

STATE_DIR = Path.home() / ".local/state/red-core"
SOCKET = STATE_DIR / "mpv.sock"

expected_uri = (
    sys.argv[1]
    if len(sys.argv) > 1
    else ""
)

def title_of(value):
    if not value:
        return ""

    if value.startswith("file://"):
        value = unquote(
            urlparse(value).path
        )

    return Path(value).stem

result = {
    "count": 0,
    "position": -1,
    "current": "",
    "next": "",
}

if not SOCKET.exists():
    print(json.dumps(result))
    raise SystemExit(0)

try:
    sock = socket.socket(
        socket.AF_UNIX,
        socket.SOCK_STREAM
    )

    sock.connect(str(SOCKET))

    requests = [
        {
            "command": [
                "get_property",
                "playlist"
            ],
            "request_id": 1
        },
        {
            "command": [
                "get_property",
                "playlist-pos"
            ],
            "request_id": 2
        },
    ]

    for request in requests:
        sock.sendall(
            (
                json.dumps(request) + "\n"
            ).encode()
        )

    stream = sock.makefile()
    responses = {}

    while len(responses) < 2:
        line = stream.readline()

        if not line:
            break

        data = json.loads(line)

        request_id = data.get(
            "request_id"
        )

        if request_id:
            responses[request_id] = (
                data.get("data")
            )

    sock.close()

    playlist = (
        responses.get(1) or []
    )

    position = responses.get(2)

    if position is None:
        position = -1

    if (
        expected_uri and
        0 <= position < len(playlist)
    ):
        current_filename = (
            playlist[position].get(
                "filename",
                ""
            )
        )

        expected_path = unquote(
            urlparse(expected_uri).path
        )

        current_path = current_filename

        if current_path.startswith(
            "file://"
        ):
            current_path = unquote(
                urlparse(
                    current_path
                ).path
            )

        try:
            if (
                Path(current_path).resolve()
                !=
                Path(expected_path).resolve()
            ):
                print(json.dumps(result))
                raise SystemExit(0)
        except Exception:
            pass

    result["count"] = len(playlist)
    result["position"] = position

    if 0 <= position < len(playlist):
        result["current"] = title_of(
            playlist[position].get(
                "filename",
                ""
            )
        )

        if position + 1 < len(playlist):
            result["next"] = title_of(
                playlist[
                    position + 1
                ].get(
                    "filename",
                    ""
                )
            )

except Exception:
    pass

print(
    json.dumps(
        result,
        ensure_ascii=False
    )
)
