#!/usr/bin/env python3

import json
import os
import subprocess
import sys
import tempfile
import uuid


ENV = os.environ.copy()
ENV["LC_ALL"] = "C"


def output(data):
    print(
        json.dumps(
            data,
            ensure_ascii=False,
            separators=(",", ":"),
        ),
        flush=True,
    )


def run(args, timeout=28):
    try:
        result = subprocess.run(
            args,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
            env=ENV,
        )

        return (
            result.returncode,
            result.stdout.strip(),
            result.stderr.strip(),
        )

    except subprocess.TimeoutExpired:
        return (
            124,
            "",
            "Network operation timed out",
        )


def result(
    action,
    success,
    message,
    request_id=None,
    **extra,
):
    data = {
        "event": "action-result",
        "action": action,
        "success": bool(success),
        "message": str(message),
    }

    if request_id is not None:
        data["requestId"] = request_id

    data.update(extra)

    output(data)


def active_uuid(iface):
    code, stdout, _ = run([
        "nmcli",
        "-t",
        "--escape",
        "no",
        "-f",
        "UUID,DEVICE",
        "connection",
        "show",
        "--active",
    ], 8)

    if code != 0:
        return ""

    for line in stdout.splitlines():
        try:
            uuid_value, device = (
                line.rsplit(":", 1)
            )
        except ValueError:
            continue

        if device == iface:
            return uuid_value

    return ""


def restore(uuid_value, iface):
    if not uuid_value:
        return

    run([
        "nmcli",
        "--wait",
        "12",
        "connection",
        "up",
        "uuid",
        uuid_value,
        "ifname",
        iface,
    ], 16)


def delete_profile(uuid_value):
    if not uuid_value:
        return

    run([
        "nmcli",
        "--wait",
        "8",
        "connection",
        "delete",
        "uuid",
        uuid_value,
    ], 10)


def password_file(password):
    runtime = os.environ.get(
        "XDG_RUNTIME_DIR",
        ""
    )

    if not runtime:
        candidate = (
            f"/run/user/{os.getuid()}"
        )

        runtime = (
            candidate
            if os.path.isdir(candidate)
            else tempfile.gettempdir()
        )

    fd, path = tempfile.mkstemp(
        prefix="redcore-wifi-",
        dir=runtime,
        text=True,
    )

    try:
        os.fchmod(fd, 0o600)

        with os.fdopen(
            fd,
            "w",
            encoding="utf-8",
        ) as handle:
            handle.write(
                "802-11-wireless-security.psk:"
                + password
                + "\n"
            )

    except Exception:
        try:
            os.close(fd)
        except Exception:
            pass

        try:
            os.unlink(path)
        except Exception:
            pass

        raise

    return path


def activate(
    uuid_value,
    iface,
    password="",
):
    secret_path = ""

    try:
        command = [
            "nmcli",
            "--wait",
            "22",
            "connection",
            "up",
            "uuid",
            uuid_value,
            "ifname",
            iface,
        ]

        if password:
            secret_path = password_file(
                password
            )

            command += [
                "passwd-file",
                secret_path,
            ]

        return run(
            command,
            26,
        )

    finally:
        if secret_path:
            try:
                os.unlink(
                    secret_path
                )
            except FileNotFoundError:
                pass
            except Exception:
                pass


def create_profile(
    ssid,
    iface,
    security_mode,
    hidden,
):
    name = (
        "redcore-" +
        uuid.uuid4().hex[:12]
    )

    command = [
        "nmcli",
        "--wait",
        "10",
        "connection",
        "add",
        "type",
        "wifi",
        "ifname",
        iface,
        "con-name",
        name,
        "ssid",
        ssid,
        "connection.autoconnect",
        "yes",
    ]

    if hidden:
        command += [
            "802-11-wireless.hidden",
            "yes",
        ]

    if security_mode == "wpa-psk":
        command += [
            "802-11-wireless-security.key-mgmt",
            "wpa-psk",
        ]

    elif security_mode == "sae":
        command += [
            "802-11-wireless-security.key-mgmt",
            "sae",
        ]

    code, stdout, stderr = run(
        command,
        14,
    )

    if code != 0:
        return (
            "",
            stderr or stdout
            or "Could not create Wi-Fi profile",
        )

    code, uuid_out, stderr = run([
        "nmcli",
        "-g",
        "connection.uuid",
        "connection",
        "show",
        "id",
        name,
    ], 8)

    if (
        code != 0
        or not uuid_out.strip()
    ):
        run([
            "nmcli",
            "connection",
            "delete",
            "id",
            name,
        ], 8)

        return (
            "",
            stderr
            or "Could not read new profile UUID",
        )

    return (
        uuid_out.strip().splitlines()[0],
        "",
    )


def connect(command):
    request_id = command.get(
        "requestId"
    )

    iface = str(
        command.get(
            "device",
            ""
        )
    ).strip()

    ssid = str(
        command.get(
            "ssid",
            ""
        )
    ).strip()

    password = str(
        command.get(
            "password",
            ""
        )
    )

    saved_uuid = str(
        command.get(
            "savedUuid",
            ""
        )
    ).strip()

    security_mode = str(
        command.get(
            "securityMode",
            "open"
        )
    ).strip()

    hidden = bool(
        command.get(
            "hidden",
            False
        )
    )

    protected = (
        security_mode != "open"
    )

    if not iface or not ssid:
        result(
            "connect",
            False,
            "Missing Wi-Fi information",
            request_id,
        )
        return

    previous_uuid = active_uuid(
        iface
    )

    # -----------------------------------------------
    # First try the saved profile using its own
    # NetworkManager-stored credentials.
    # -----------------------------------------------

    if saved_uuid and not password:
        code, stdout, stderr = activate(
            saved_uuid,
            iface,
        )

        if code == 0:
            result(
                "connect",
                True,
                "Connected to " + ssid,
                request_id,
            )
            return

        restore(
            previous_uuid,
            iface,
        )

        result(
            "connect",
            False,
            stderr or stdout
            or "Connection failed",
            request_id,
            passwordRequired=protected,
        )
        return

    if protected and not password:
        result(
            "connect",
            False,
            "Password required",
            request_id,
            passwordRequired=True,
        )
        return

    # -----------------------------------------------
    # For a new password, make a new profile.
    #
    # This also avoids fighting an old saved PSK.
    # We remove the old profile only AFTER the new
    # connection really succeeds.
    # -----------------------------------------------

    new_uuid, error = create_profile(
        ssid,
        iface,
        security_mode,
        hidden,
    )

    if not new_uuid:
        result(
            "connect",
            False,
            error,
            request_id,
        )
        return

    code, stdout, stderr = activate(
        new_uuid,
        iface,
        password,
    )

    password = ""

    if code != 0:
        delete_profile(
            new_uuid
        )

        restore(
            previous_uuid,
            iface,
        )

        result(
            "connect",
            False,
            stderr or stdout
            or "Connection failed",
            request_id,
            passwordRequired=protected,
        )
        return

    # New profile proved valid.
    if (
        saved_uuid
        and saved_uuid != new_uuid
    ):
        delete_profile(
            saved_uuid
        )

    # Friendly name after successful activation.
    run([
        "nmcli",
        "connection",
        "modify",
        "uuid",
        new_uuid,
        "connection.id",
        ssid,
    ], 8)

    result(
        "connect",
        True,
        "Connected to " + ssid,
        request_id,
    )


def main():
    try:
        line = sys.stdin.readline()

        command = json.loads(
            line
        )

        action = str(
            command.get(
                "action",
                ""
            )
        )

        request_id = command.get(
            "requestId"
        )

        if action == "connect":
            connect(command)
            return

        if action == "disconnect":
            iface = str(
                command.get(
                    "device",
                    ""
                )
            )

            code, stdout, stderr = run([
                "nmcli",
                "--wait",
                "12",
                "device",
                "disconnect",
                iface,
            ], 15)

            result(
                action,
                code == 0,
                (
                    "Disconnected"
                    if code == 0
                    else stderr or stdout
                    or "Disconnect failed"
                ),
                request_id,
            )

            return

        if action == "forget":
            uuid_value = str(
                command.get(
                    "uuid",
                    ""
                )
            )

            code, stdout, stderr = run([
                "nmcli",
                "--wait",
                "10",
                "connection",
                "delete",
                "uuid",
                uuid_value,
            ], 12)

            result(
                action,
                code == 0,
                (
                    "Network forgotten"
                    if code == 0
                    else stderr or stdout
                    or "Forget failed"
                ),
                request_id,
            )

            return

        if action == "wifi":
            enabled = bool(
                command.get(
                    "enabled",
                    True
                )
            )

            code, stdout, stderr = run([
                "nmcli",
                "radio",
                "wifi",
                "on" if enabled else "off",
            ], 10)

            result(
                action,
                code == 0,
                (
                    "Wi-Fi enabled"
                    if code == 0 and enabled
                    else
                    "Wi-Fi disabled"
                    if code == 0
                    else stderr or stdout
                    or "Wi-Fi action failed"
                ),
                request_id,
            )

            return

        result(
            action,
            False,
            "Unsupported network action",
            request_id,
        )

    except Exception as exc:
        output({
            "event": "action-result",
            "action": "",
            "success": False,
            "message": str(exc),
        })


if __name__ == "__main__":
    main()
